modules = ["python-base-3.13", "nodejs-24"]
[nix]
channel = "stable-25_05"
packages = ["unzip", "php"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "php -S 0.0.0.0:5000 dev-router.php"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80
